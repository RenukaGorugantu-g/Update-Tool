# Live Gmail settings
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# For production (Render deployment):
# GOOGLE_REDIRECT_URI=https://update-tool.onrender.com/auth/google/callback

# Google Chat incoming webhook URLs for different team spaces
CHAT_WEBHOOK_SPACE_DEVELOPMENT=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=API_KEY&token=TOKEN
CHAT_WEBHOOK_SPACE_DESIGN=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=API_KEY&token=TOKEN
CHAT_WEBHOOK_SPACE_MARKETING=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=API_KEY&token=TOKEN
CHAT_WEBHOOK_SPACE_SALES=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=API_KEY&token=TOKEN
CHAT_WEBHOOK_SPACE_CLIENT_SUCCESS=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=API_KEY&token=TOKEN
CHAT_WEBHOOK_SPACE_GENERAL=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=API_KEY&token=TOKEN

# Frontend URL (for email notifications and redirects)
FRONTEND_URL=http://localhost:3000

