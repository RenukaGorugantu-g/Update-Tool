# Live Gmail settings
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Google Chat incoming webhook URLs
CHAT_WEBHOOK_SPACE_DEVELOPMENT=https://chat.googleapis.com/v1/spaces/AAA.../messages?key=...
CHAT_WEBHOOK_SPACE_DESIGN=https://chat.googleapis.com/v1/spaces/BBB.../messages?key=...
CHAT_WEBHOOK_SPACE_MARKETING=https://chat.googleapis.com/v1/spaces/CCC.../messages?key=...
CHAT_WEBHOOK_SPACE_SALES=https://chat.googleapis.com/v1/spaces/DDD.../messages?key=...
CHAT_WEBHOOK_SPACE_CLIENT_SUCCESS=https://chat.googleapis.com/v1/spaces/EEE.../messages?key=...
CHAT_WEBHOOK_SPACE_GENERAL=https://chat.googleapis.com/v1/spaces/FFF.../messages?key=...
