# Frontend backend API URL
# For local development:
VITE_API_BASE=http://localhost:5000

# Clerk publishable key for the Vite frontend
# Provide your real Clerk publishable key here:
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# For production deployment on Vercel:
# Set this to your Render backend URL:
# VITE_API_BASE=https://update-tool.onrender.com

# Office/remote detection for attendance logs
# Add this in Vercel Project Settings → Environment Variables
# Example:
# VITE_OFFICE_IP=196.12.41.58
# Or a comma-separated list if you want multiple office IPs:
# VITE_OFFICE_IPS=196.12.41.58,10.0.0.15

